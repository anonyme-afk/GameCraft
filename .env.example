# Exemple de configuration des fournisseurs d'IA.
# Copiez ce fichier en ".env" et remplissez vos propres clés.
# ".env" est ignoré par git : NE committez JAMAIS vos vraies clés.

# --- Fournisseurs cloud (facultatif) ---
# Laissez vide si vous utilisez seulement un modèle local (Ollama / LM Studio).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Modèles locaux ---
# Ollama (défaut : port 11434). Pensez à lancer : OLLAMA_ORIGINS=* ollama serve
OLLAMA_BASE=http://localhost:11434

# LM Studio (API compatible OpenAI, défaut : port 1234)
LMSTUDIO_BASE=http://localhost:1234
