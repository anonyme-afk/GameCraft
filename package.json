{
  "name": "gamecraft-studio",
  "productName": "GameCraft Studio",
  "version": "1.0.0",
  "description": "Studio professionnel de création de jeux vidéo assistée par IA",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "bundle": "node scripts/bundle.js",
    "build:js": "node scripts/bundle.js",
    "pack": "node scripts/build.js --dir",
    "dist": "node scripts/build.js",
    "dist:portable": "node scripts/build.js --win portable"
  },
  "keywords": [
    "gamedev",
    "ai",
    "studio",
    "desktop",
    "godot",
    "html5",
    "threejs"
  ],
  "author": "GameCraft",
  "license": "MIT",
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.gamecraft.studio",
    "productName": "GameCraft Studio",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "signingHashAlgorithms": null,
      "signExts": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Development"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GameCraft Studio"
    },
    "files": [
      "studio.html",
      "styles.css",
      "app.js",
      "js/**/*",
      "electron/**/*",
      "assets/**/*"
    ]
  }
}
